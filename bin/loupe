#!/bin/sh
# Entry point only (design §10.1: renamed rvw -> loupe 2026-08-14). All
# behaviour lives in the review/ package; the name lives in review/__init__.py.
#
# The adapters hand agents a bare `loupe <verb>`, run from whatever directory
# the repository under review happens to be (§6.3), so this shim must hold two
# properties the naive form did not:
#
#   1. It survives being symlinked onto PATH. `$0` is the symlink, not its
#      target, so ROOT must be derived after walking the link chain.
#   2. It loads THIS checkout's `review` package and no other. `python3 -m`
#      puts the caller's cwd ahead of PYTHONPATH, so a cwd that happens to
#      contain a `review/` directory silently wins — which is exactly the
#      shape of this workbench and its extraction candidate side by side.
#      PYTHONSAFEPATH (3.11+) drops cwd from sys.path, leaving ROOT
#      authoritative.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in
        /*) SELF=$LINK ;;
        *)  SELF=$(dirname "$SELF")/$LINK ;;
    esac
done
ROOT=$(cd "$(dirname "$SELF")/.." && pwd)
# Both overrides below are ENVIRONMENT variables, so without care every
# subprocess the tool spawns inherits them — and the gate manifest is
# subprocesses. On the first per-project onboarding (2026-08-19) that
# failed twelve of sixteen gates on import errors: PYTHONSAFEPATH strips the script directory
# and cwd from sys.path, which is exactly what ad-hoc check scripts rely on,
# and the leaked PYTHONPATH let any gate import this tool's own package by
# accident. A gate must run in the environment the CALLER of loupe had, so
# the caller's values are stashed here — presence of the stash variable
# distinguishes "caller had it set (to this value)" from "caller had it
# unset"; LOUPE_SHIM marks that the stash protocol ran at all, so the
# emitter can tell "shim, caller had nothing" from "no shim, unknown
# caller". review/emit.py restores from these for each gate subprocess.
# The LOUPE_ prefix is literal because this shim cannot import the package
# that owns the name; a tool rename must update it here too (§10.1).
# Round-1 F2: each invocation establishes a FRESH stash state. A stash
# variable already present in the caller's environment — leaked from an
# outer invocation or exported by accident — would otherwise survive here
# and be restored into the gates as a value the caller never set, so an
# unset caller variable must CLEAR any pre-existing stash, not merely
# decline to overwrite it.
if [ "${PYTHONSAFEPATH+set}" = set ]; then
    LOUPE_CALLER_PYTHONSAFEPATH=$PYTHONSAFEPATH
    export LOUPE_CALLER_PYTHONSAFEPATH
else
    unset LOUPE_CALLER_PYTHONSAFEPATH
fi
if [ "${PYTHONPATH+set}" = set ]; then
    LOUPE_CALLER_PYTHONPATH=$PYTHONPATH
    export LOUPE_CALLER_PYTHONPATH
else
    unset LOUPE_CALLER_PYTHONPATH
fi
# The interpreter, by its versioned name first (2026-09-22). The package
# supports exactly one minor (REQUIRES_PYTHON in review/__init__.py), and a
# machine's bare `python3` is whatever its package manager last linked:
# Homebrew moves that alias to a new minor on its own schedule. Naming the
# minor keeps this launcher on the supported interpreter wherever one is
# installed. The bare name is the fallback; the package's first statement
# names both versions when that one is too old.
PYTHON=python3.15
command -v "$PYTHON" >/dev/null 2>&1 || PYTHON=python3
LOUPE_SHIM=1 PYTHONSAFEPATH=1 PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$PYTHON" -m review "$@"
